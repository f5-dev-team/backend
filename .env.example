# 로컬 MySQL 예시. 운영에서는 배포 환경의 비밀 저장소에 실제 접속 정보를 설정한다.
DB_URL=jdbc:mysql://localhost:3306/scholarship_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=scholarship_app
DB_PASSWORD=

# 로컬 개발 프론트엔드 주소. 운영 출처는 배포 환경에서 명시적으로 설정한다.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT_SECRET은 최소 256-bit Base64 secret을 별도 보안 채널로 생성·설정한다.
# 실제 secret이나 운영 자격 증명을 이 파일에 작성하거나 커밋하지 않는다.
# JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600

# .env는 자동 로드되지 않으므로 실행 환경에 등록한다.
DOCUMENT_STORAGE_ENABLED=false
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=example-scholarship-bucket
# AWS SDK 기본 자격 증명 체인(환경변수·프로필·서버 IAM 역할)을 사용한다.
# IAM 역할/프로필을 우선 사용하고, 필요한 경우에만 비밀 저장소에서 설정한다.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
