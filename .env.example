# Database 설정
DB_URL=jdbc:mysql://[여기에 RDS 엔드포인트]:3306/scholarship_db?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=admin
DB_PASSWORD=[여기에 RDS 비밀번호]

# AWS S3 설정: .env는 자동 로드되지 않으므로 실행 환경에 등록한다.
DOCUMENT_STORAGE_ENABLED=false
AWS_S3_BUCKET=
AWS_REGION=
# 최소 256-bit Base64 secret을 별도 보안 채널로 생성·설정한다. 실제 값은 커밋하지 않는다.
# JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
# 인증은 AWS SDK 기본 인증 체인(로컬 프로필·환경변수·서버 IAM 역할)을 사용한다.
# 로컬 프로필 사용 시 AWS_PROFILE을 지정할 수 있다.
# 환경변수 인증 이름: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN
# 실제 인증 값은 이 파일에 작성하거나 커밋하지 않는다.
